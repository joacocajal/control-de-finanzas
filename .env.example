# ─── Supabase ───────────────────────────────────────────────
# Obtener desde: Supabase Dashboard → Project Settings → API

# URL del proyecto (segura para exponer en cliente)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Anon key (segura: RLS protege los datos)
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Service Role Key — SOLO para server-side (NUNCA con NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui

# ─── Gemini API ─────────────────────────────────────────────
# Obtener desde: aistudio.google.com → API Keys
GEMINI_API_KEY=tu-gemini-api-key-aqui
GOOGLE_MODEL=gemini-2.5-flash

# ─── Claves de APIs internas ─────────────────────────────────
# Generar con: openssl rand -hex 24
SUMMARY_API_KEY=generar-con-openssl
CRON_SECRET=generar-con-openssl

# ─── App ────────────────────────────────────────────────────
# URL de la app (usar en production para callbacks de auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── n8n Webhooks ───────────────────────────────────────────
# Webhook del Agente IA conversacional
NEXT_PUBLIC_N8N_WEBHOOK_AGENT=https://tu-n8n.dominio.com/webhook/ascend-agent

# Webhook para sugerir hitos con IA (FASE 3 Roadmap)
NEXT_PUBLIC_N8N_WEBHOOK_MILESTONES=https://tu-n8n.dominio.com/webhook/ascend-milestones
